# ========================================
# JohnMusic 2.0 — Environment Variables
# ========================================
# Copie este arquivo para .env e preencha os valores

# ----------------------------------------
# SPOTIFY
# ----------------------------------------
# 1. Acesse https://developer.spotify.com/dashboard
# 2. Clique em "Create App"
# 3. Preencha:
#    - App name: JohnMusic 2.0
#    - App description: Minha plataforma de música
#    - Redirect URI: http://localhost:5173/callback
#    - APIs: Web API + Web Playback SDK
# 4. Copie o Client ID abaixo

VITE_SPOTIFY_CLIENT_ID=seu_client_id_aqui

# URI de redirecionamento após login (deve ser igual ao registrado no Dashboard)
VITE_SPOTIFY_REDIRECT_URI=http://localhost:5173/callback
